{
  "name": "Jastip China - Monitoring & Cron System",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "a1-schedule",
      "name": "Trigger Uptime (5m)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, -300]
    },
    {
      "parameters": {
        "url": "https://jastip-nihao.vercel.app/api/health"
      },
      "id": "a2-health",
      "name": "Health Check",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, -300]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.status }}",
              "rightValue": "ok",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ]
        }
      },
      "id": "a3-if",
      "name": "Cek Status",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [440, -300]
    },
    {
      "parameters": {
        "resource": "message",
        "chatId": "GANTI_CHAT_ID",
        "text": "=🚨 ALERT Jastip China: App/DB Down ({{ $json.db }}). Cek Vercel dashboard."
      },
      "id": "a4-telegram",
      "name": "Telegram Alert",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [660, -320],
      "credentials": {
        "telegramApi": {
          "id": "GANTI_CRED_ID",
          "name": "Telegram Jastip"
        }
      }
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "b1-schedule",
      "name": "Trigger Jobs (15m)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "url": "https://jastip-nihao.vercel.app/api/cron/cek-kadaluwarsa",
        "options": {
          "headers": {
            "parameter": [
              {
                "name": "Authorization",
                "value": "Bearer M4kVEtDu9j1x708Q2Ucz8NFHItU3nJWUe1ZEGqCiBxg="
              }
            ]
          }
        }
      },
      "id": "b2-kadaluwarsa",
      "name": "Cek Kadaluwarsa",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "url": "https://jastip-nihao.vercel.app/api/cron/reminder-pembayaran",
        "options": {
          "headers": {
            "parameter": [
              {
                "name": "Authorization",
                "value": "Bearer M4kVEtDu9j1x708Q2Ucz8NFHItU3nJWUe1ZEGqCiBxg="
              }
            ]
          }
        }
      },
      "id": "b3-reminder",
      "name": "Reminder Pembayaran",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 14 * * *"
            }
          ]
        }
      },
      "id": "c1-schedule",
      "name": "Trigger Laporan (21:00)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 250]
    },
    {
      "parameters": {
        "url": "https://jastip-nihao.vercel.app/api/cron/laporan-harian",
        "options": {
          "headers": {
            "parameter": [
              {
                "name": "Authorization",
                "value": "Bearer M4kVEtDu9j1x708Q2Ucz8NFHItU3nJWUe1ZEGqCiBxg="
              }
            ]
          }
        }
      },
      "id": "c2-laporan",
      "name": "Ambil Laporan",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 250]
    },
    {
      "parameters": {
        "resource": "message",
        "chatId": "GANTI_CHAT_ID",
        "text": "={{ $json.pesan }}"
      },
      "id": "c3-telegram",
      "name": "Kirim Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [440, 250],
      "credentials": {
        "telegramApi": {
          "id": "GANTI_CRED_ID",
          "name": "Telegram Jastip"
        }
      }
    }
  ],
  "connections": {
    "Trigger Uptime (5m)": {
      "main": [[{"node": "Health Check", "type": "main", "index": 0}]]
    },
    "Health Check": {
      "main": [[{"node": "Cek Status", "type": "main", "index": 0}]]
    },
    "Cek Status": {
      "main": [[{"node": "Telegram Alert", "type": "main", "index": 0}], []]
    },
    "Trigger Jobs (15m)": {
      "main": [[{"node": "Cek Kadaluwarsa", "type": "main", "index": 0}]]
    },
    "Cek Kadaluwarsa": {
      "main": [[{"node": "Reminder Pembayaran", "type": "main", "index": 0}]]
    },
    "Trigger Laporan (21:00)": {
      "main": [[{"node": "Ambil Laporan", "type": "main", "index": 0}]]
    },
    "Ambil Laporan": {
      "main": [[{"node": "Kirim Telegram", "type": "main", "index": 0}]]
    }
  }
}